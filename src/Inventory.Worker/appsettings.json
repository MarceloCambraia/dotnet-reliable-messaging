{
  "ConnectionStrings": {
    "Inventory": "Host=localhost;Port=5432;Database=inventory;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "ClientName": "inventory-worker"
  },
  "Inventory": {
    "Exchange": "orders.events",
    "Queue": "inventory.order-created",
    "PrefetchCount": 16,
    "RetryDelays": [ "00:00:05", "00:00:30", "00:02:00" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j} trace={TraceId}{NewLine}{Exception}"
        }
      }
    ]
  }
}
