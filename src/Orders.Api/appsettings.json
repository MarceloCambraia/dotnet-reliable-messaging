{
  "ConnectionStrings": {
    "Orders": "Host=localhost;Port=5432;Database=orders;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "ClientName": "orders-api"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j} trace={TraceId}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
